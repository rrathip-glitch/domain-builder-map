 "builder_queries": {
  "_about": "Run for every builder in data/spine.json. {name} is the builder's search name (builder_search_names; default is the quoted spine name). A result is kept only if the builder's name (builder_must, default the search name) appears in the headline or snippet. Tier 1 runs tier1_terms for ranks 1 to tier1_max_rank, newest-first and by relevance; tier 2 runs every term for everyone else and the remaining terms for the top group.",
  "tier1_max_rank": 26,
  "tier1_terms": [
   "\"senior notes\"",
   "\"credit facility\"",
   "\"land banking\"",
   "acquisition",
   "CFO"
  ],
  "tier2_terms": [
   "land lots",
   "\"joint venture\"",
   "names president",
   "Moody's Fitch rating",
   "earnings lots"
  ],
  "small_builder_from_rank": 51,
  "small_builder_terms": [
   "acquisition",
   "financing land",
   "names president"
  ],
  "gdelt_template": "{name} (\"senior notes\" OR \"credit facility\" OR \"land banking\" OR \"land bank\" OR acquisition OR \"chief financial officer\")"
 },
